{
  "name": "mythical-beings-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23 || >=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "check:runtime": "node scripts/verify-runtime.mjs",
    "dev": "vite",
    "predev": "npm run check:runtime",
    "build": "npm run typecheck && vite build",
    "prebuild": "npm run check:runtime",
    "format": "eslint src tests supabase/functions scripts vite.config.ts vitest.config.ts vitest.coverage.config.ts --ext ts,tsx --fix",
    "lint": "eslint src tests supabase/functions scripts vite.config.ts vitest.config.ts vitest.coverage.config.ts --ext ts,tsx --report-unused-disable-directives",
    "lint:ci": "node scripts/verify-lint-budget.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "pretest": "npm run check:runtime",
    "test:coverage": "vitest --config vitest.coverage.config.ts --run --coverage.enabled --coverage.reporter=text --coverage.reporter=json-summary --silent && node scripts/verify-critical-coverage.mjs",
    "pretest:coverage": "npm run check:runtime",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck:edge": "npx --yes deno@2.9.6 check --node-modules-dir=none supabase/functions/deal-cards/index.ts",
    "verify:bundle-budget": "node scripts/verify-bundle-budget.mjs",
    "verify:public-artifact": "node scripts/verify-public-artifact.mjs",
    "verify:production-logging": "node scripts/verify-production-logging.mjs"
  },
  "dependencies": {
    "@mythicalb/ardor-core": "0.2.0",
    "@mythicalb/ardor-provider": "0.2.0",
    "@mythicalb/sdk": "0.2.0",
    "@supabase/supabase-js": "^2.49.4",
    "lucide-react": "^1.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "supabase": "^2.22.12",
    "tailwindcss": "^4.1.4",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.1"
  }
}
